{
  "manifest_version": 3,
  "name": "Accessify",
  "version": "1.2.0",
  "description": "A comprehensive browser extension that removes barriers and increases accessibility for people with vision, hearing, and cognitive disabilities.",
  "permissions": ["activeTab", "storage"],
  "commands": {
    "toggle-widget-visibility": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Option+Z"
      },
      "description": "Show or hide the Accessify floating button"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "settings-model.js",
        "preset-helpers.js",
        "feature-reading-overlay.js",
        "feature-tts.js",
        "feature-stylesheet.js",
        "widget-controller.js",
        "content-main.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["widget.html", "widget.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
